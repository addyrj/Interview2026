### **CI/CD Pipeline**

yaml

```
# GitHub Actions Workflow
name: Deploy Repair Service

on:
  push:
    branches: [ main ]
    paths: [ 'services/repair/**' ]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v2
      - name: Setup PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: '8.3'
      - name: Install dependencies
        run: composer install
      - name: Run tests
        run: php artisan test

  build:
    needs: test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v2
      - name: Build Docker image
        run: |
          docker build -t cashify/repair-service:${{ github.sha }} .
          docker tag cashify/repair-service:${{ github.sha }} cashify/repair-service:latest

  deploy:
    needs: build
    runs-on: ubuntu-latest
    steps:
      - name: Deploy to Kubernetes
        run: |
          kubectl set image deployment/repair-service \
            repair-service=cashify/repair-service:${{ github.sha }}
```

